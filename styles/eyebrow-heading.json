{
    "$schema": "https://schemas.wp.org/trunk/theme.json",
    "version": 3,
    "title": "Eyebrow Heading",
    "slug": "eyebrow-heading",
    "description": "An eyebrow heading style, typically used for small uppercase text above main headings.",
    "blockTypes": [ "core/heading", "core/paragraph" ],
    "styles": {
        "spacing": {
            "margin": { "top": "0", "bottom": "0" }
        },
        "typography": {
            "fontSize": "var(--wp--preset--font-size--xl)",
            "fontFamily": "var(--wp--preset--font-family--font-athletics)",
            "fontWeight": "800"
        }
    }
}