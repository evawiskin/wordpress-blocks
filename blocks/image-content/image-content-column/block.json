{
    "$schema": "https://raw.githubusercontent.com/AdvancedCustomFields/schemas/main/json/block.json",
    "name": "hiyield/image-content-column",
    "title": "Image Content Column",
    "description": "",
    "style": "",
    "script": "",
    "category": "custom-layout",
    "parent": ["hiyield/image-content"],
    "icon": "columns",
