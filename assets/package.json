{
	"name": "tailwind-full",
	"version": "3.0.0",
	"description": "TailWind Full + Clean CSS + Purge CSS + Image Min + JS Terser",
	"author": "Justin Lipkin <justin@hiyield.co.uk>",
	"contributors": [
		"Callum Holloway <callum@hiyield.co.uk> (https://callumholloway.com)"
	],
	"license": "GPLv3",
	"scripts": {
		"dev": "npm run development",
		"development": "webpack --config ./config/webpack.config.js --mode=development --stats=detailed",
		"prod": "npm run production",
		"production": "webpack --config ./config/webpack.config.js --mode=production --stats=minimal",
		"watch:dev": "npm run watch:development",
		"watch:development": "webpack --config ./config/webpack.config.js --watch --mode=development --stats=minimal",
		"watch:prod": "npm run watch:production",
		"watch:production": "webpack --config ./config/webpack.config.js --watch --mode=production --stats=minimal",
		"build": "npm run development",
		"watch": "npm run watch:development"
	},
	"devDependencies": {
		"@tailwindcss/aspect-ratio": "^0.4.0",
		"astroturf": "^1.0.1",
		"autoprefixer": "^10.4.2",
		"babel-loader": "^8.2.3",
		"browser-sync": "^2.27.10",
		"browser-sync-webpack-plugin": "^2.3.0",
		"css-loader": "^4.3.0",
		"cssnano": "^5.1.0",
		"file-loader": "^6.1.0",
		"fontmin-webpack": "^3.2.0",
		"img-loader": "^3.0.2",
		"mini-css-extract-plugin": "^2.6.0",
		"postcss": "^8.4.7",
		"postcss-clean": "^1.2.2",
		"postcss-loader": "^6.2.1",
		"postcss-sort-media-queries": "^1.7.26",
		"precss": "^4.0.0",
		"progress-bar-webpack-plugin": "^2.1.0",
		"style-loader": "^1.2.1",
		"tailwindcss": "^3.0.23",
		"webpack": "^5.70.0",
		"webpack-cli": "^4.9.2"
	},
	"dependencies": {
		"tailwind-container-break-out": "^2.0.6"
	}
}
